# Copy to `.env` and fill in locally. NEVER commit `.env`
# This file holds KEY NAMES ONLY. Do not put real values here, not even "test" ones.

# --- Runtime ---
NODE_ENV=development
PORT=3001
HOST=0.0.0.0
LOG_LEVEL=debug

# --- AWS / DynamoDB ---
# Leave the credentials blank to use DynamoDB Local (set DYNAMODB_ENDPOINT below).
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
DYNAMODB_TABLE=urlgen-links
DYNAMODB_ENDPOINT=http://127.0.0.1:8000

# --- Redis (cache, rate limiting, click buffer) ---
REDIS_URL=redis://127.0.0.1:6379

# --- ClickHouse (analytics) ---
CLICKHOUSE_URL=http://127.0.0.1:8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=urlgen

# --- Click pipeline ---
# CLICK_BUFFER_MAX caps the Redis buffer. Past it, clicks are dropped and counted
# rather than allowed to grow until Redis takes the box down with it.
CLICK_BUFFER_MAX=100000
# Rows per ClickHouse INSERT. ClickHouse wants big batches; one-row inserts are the
# classic way to make it miserable.
CLICK_FLUSH_BATCH_SIZE=1000
# Flush at least this often even when the batch is not full, so a quiet link's
# clicks still show up in the dashboard within seconds.
CLICK_FLUSH_INTERVAL_MS=5000
# Run the flusher inside the API process. Exactly ONE process must flush — leave
# this false for API replicas and run `pnpm consumer` as its own process instead.
CLICK_CONSUMER_ENABLED=true

# --- Analytics (Phase 4) ---
# Short cache in front of the analytics queries, and the tick the request clock is
# floored to — every request inside one tick resolves the identical window, so a
# cached response is byte-identical to the fresh one it stands in for. Also the
# dashboard's poll interval. 0 turns caching off without changing anything else.
ANALYTICS_CACHE_TTL_SECONDS=15

# Origins the dashboard may be served from, comma-separated. Exact matches only —
# no wildcards, no patterns. Add the deployed dashboard's origin here.
CORS_ORIGINS=http://localhost:3000

# --- Secrets (required when NODE_ENV=production) ---
# INTERNAL_API_TOKEN authenticates the Cloudflare Worker to the origin. Min 32 chars.
#   Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
INTERNAL_API_TOKEN=
# VISITOR_HASH_SALT seeds the daily-rotating hash used instead of storing IPs. Min 16 chars.
VISITOR_HASH_SALT=
# Google Safe Browsing lookup key (Phase 1).
SAFE_BROWSING_API_KEY=

# --- Cloudflare (edge cache invalidation) ---
# All three or none — two out of three makes the origin look configured while
# every KV write fails, so edits would silently never reach the edge.
# Leave blank for local development: `wrangler dev` simulates its own namespace,
# so there is nothing at api.cloudflare.com to invalidate.
# The API token needs exactly one permission: Account > Workers KV Storage > Edit.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_KV_NAMESPACE_ID=
CLOUDFLARE_API_TOKEN=

# --- Public ---
SHORT_DOMAIN=localhost:8787

# ---------------------------------------------------------------------------
# Next.js dashboard locals go in apps/web/.env.local (also gitignored). These are
# inlined into the browser bundle at build time — never put a secret in one:
#   NEXT_PUBLIC_API_BASE="http://localhost:3001"
#   NEXT_PUBLIC_SHORT_DOMAIN="localhost:8787"
#   NEXT_PUBLIC_OWNER_ID="public"     # placeholder identity until auth exists
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Cloudflare Worker locals go in apps/edge/.dev.vars (also gitignored):
#   ORIGIN_API_BASE="http://127.0.0.1:3001"
#   INTERNAL_API_TOKEN="<same value as above>"
# In production set the secret with: wrangler secret put INTERNAL_API_TOKEN
# ---------------------------------------------------------------------------
