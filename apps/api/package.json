{
  "name": "@urlgen/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Origin API — write path, source of truth, analytics queries",
  "main": "src/index.ts",
  "scripts": {
    "dev": "tsx --env-file-if-exists=../../.env watch src/index.ts",
    "start": "tsx --env-file-if-exists=../../.env src/index.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit",
    "test": "vitest run",
    "table:create": "tsx --env-file-if-exists=../../.env scripts/create-table.ts"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "3.1101.0",
    "@aws-sdk/lib-dynamodb": "3.1101.0",
    "@urlgen/shared": "workspace:*",
    "fastify": "5.11.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "26.1.2",
    "@urlgen/config": "workspace:*",
    "light-my-request": "6.6.0",
    "pino-pretty": "13.1.3",
    "tsx": "4.23.1",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
